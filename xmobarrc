Config { overrideRedirect = False
       , font     = "xft:iosevka-9"
       , bgColor  = "#3f3f3f"
       , fgColor  = "#ffffff"
       , position = TopW C 90
       , commands = [ Run Cpu
                        [ "-L", "3"
                        , "-H", "50"
                        , "--high"  , "red"
                        , "--normal", "green"
                        ] 10
                    , Run Com "cat" ["/sys/class/power_supply/BAT0/capacity"] "bat0" 10
                    , Run Com "cat" ["/sys/class/power_supply/BAT1/capacity"] "bat1" 10
                    , Run Memory ["--template", "Mem: <usedratio>%"] 10
                    , Run Com "pamixer" ["--get-volume"] "volume" 5
                    , Run Swap [] 10
                    , Run Date "%a %d / %m / %Y <fc=#8be9fd>%H:%M</fc>" "date" 10
                    , Run XMonadLog
                    ]
       , sepChar  = "%"
       , template =
          "%XMonadLog% }{ %cpu% | %memory% * %swap% | %bat0% 🔋 %bat1% 🔋 | %date% | 📢 %volume% "
       }
